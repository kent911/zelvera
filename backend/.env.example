# ==== Режим работы ИИ ====
# ollama (по умолчанию, полностью локально), openai или lmstudio
LLM_BACKEND=ollama

# Каталог данных (SQLite, фото, settings.json). По умолчанию ./data
# В Docker Compose задаётся как /data и монтируется в ./data на хосте.
# ZELVERA_DATA_DIR=

# ==== Ollama (локальные модели) ====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# vision-модель для распознавания фото анализов (OCR). gemma4 поддерживает изображения.
OLLAMA_VISION_MODEL=gemma4:26b
# эмбеддинг-модель для базы научных статей
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==== OpenAI-совместимый API (llama-server / OpenAI; LLM_BACKEND=openai) ====
# Для llama-server ключ не обязателен (подставится local).
# Пример: USER_LLM_BASE_URL=http://192.168.1.100:8080/v1
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=
USER_LLM_MODEL=gpt-4o
# vision-модель для распознавания фото анализов
USER_LLM_VISION_MODEL=gpt-4o
# Примечание: эмбеддинги статей всегда считает Ollama (см. OLLAMA_EMBED_MODEL),
# независимо от LLM_BACKEND.

# ==== LM Studio (LLM_BACKEND=lmstudio) ====
# LM Studio отдаёт OpenAI-совместимый API. Включите локальный сервер
# (Developer → Start Server). Ключ обычно не нужен.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ==== Прокси (Telegram, GitHub) ====
# Прокси нужен только для внешних адресов. Запросы к 127.0.0.1, localhost,
# 192.168.*, 10.*, 172.16-31.* и *.local всегда идут напрямую, чтобы
# локальные Ollama/llama-server/kiwix оставались доступны, даже если прокси
# недоступен. Прокси задаётся отдельно для Telegram (TELEGRAM_PROXY) и
# GitHub (поле «Прокси для GitHub» в настройках).
# TELEGRAM_PROXY=socks5h://192.168.88.100:10808
# GITHUB_PROXY=socks5h://192.168.88.100:10808
