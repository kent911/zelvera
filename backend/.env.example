# ==== Режим работы ИИ ====
# ollama (по умолчанию, полностью локально) или openai
LLM_BACKEND=ollama

# ==== Ollama (локальные модели) ====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# vision-модель для распознавания фото анализов (OCR). gemma4 поддерживает изображения.
OLLAMA_VISION_MODEL=gemma4:26b
# эмбеддинг-модель для базы научных статей
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==== OpenAI-совместимый API (только если LLM_BACKEND=openai) ====
# Впишите свой ключ самостоятельно. Ключ хранится только локально.
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=
USER_LLM_MODEL=gpt-4o
# vision-модель для распознавания фото анализов
USER_LLM_VISION_MODEL=gpt-4o
# эмбеддинг-модель для базы научных статей
USER_LLM_EMBED_MODEL=text-embedding-3-small

# ==== Системный промпт (поведение ассистента) ====
# SYSTEM_PROMPT=Ты — медицинский ИИ-ассистент...
